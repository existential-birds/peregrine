{
  "name": "e1r-dspark-b5-cand",
  "base_url": "http://127.0.0.1:8080",
  "model": "models/Inkling-2-Mini-4bit",
  "launch": [
    "bash",
    "scripts/launch-mlx.sh",
    "e1r-dspark-b5-cand",
    "--model",
    "models/Inkling-2-Mini-4bit",
    "--draft-model",
    "models/Inkling-2-Mini-4bit-mtp",
    "--draft-kind",
    "dflash",
    "--draft-block-size",
    "5"
  ],
  "stop": ["bash", "scripts/stop-mlx.sh"],
  "health_timeout_s": 900,
  "concurrency": 4,
  "prefill_lengths": [4096, 32768],
  "extra_body": {"reasoning_effort": "none"},
  "temperature": 0.6,
  "memory": {"cap_gib": 36, "probe": ["bash", "scripts/mem-macos.sh"], "interval_s": 3},
  "require_ac": true
}
