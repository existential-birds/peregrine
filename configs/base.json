{
  "name": "mlx-27b-4bit-baseline",
  "base_url": "http://127.0.0.1:8080",
  "model": "mlx-community/Qwen3.8-27B-4bit",
  "launch": ["bash", "scripts/launch-mlx.sh", "baseline"],
  "stop": ["bash", "scripts/stop-mlx.sh"],
  "health_timeout_s": 3600,
  "concurrency": 4,
  "prefill_lengths": [4096, 32768],
  "extra_body": {"chat_template_kwargs": {"enable_thinking": false}},
  "temperature": 0.6,
  "memory": {"cap_gib": 36, "probe": ["bash", "scripts/mem-macos.sh"], "interval_s": 3},
  "require_ac": true
}
