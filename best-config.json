{
  "name": "best",
  "base_url": "http://127.0.0.1:8080",
  "model": "existentialbirds/Inkling-2-Mini-4bit",
  "fork_repo": "https://github.com/existential-birds/mlx-vlm",
  "fork_branch": "perf/inkling2-serving",
  "fork_commit": "f871d0b7",
  "base_checkpoint": "thinkingmachines/Inkling-2-Mini@c9d028302cd0f035fdf8e7e91f089a4ce94d2195",
  "hub_model": "existentialbirds/Inkling-2-Mini-4bit@e6d93b36b53a57f166c66373cbe20ad5e5a50982",
  "hub_draft_model": "existentialbirds/Inkling-2-Mini-MTP-4bit@b4af0a25bb8e54f5b3fbdbbc4c57b176423e92eb",
  "launch": [
    "bash",
    "scripts/launch-mlx.sh",
    "best",
    "--model",
    "existentialbirds/Inkling-2-Mini-4bit",
    "--prefill-step-size",
    "512",
    "--cache-limit",
    "4294967296",
    "--max-num-seqs",
    "4"
  ],
  "stop": ["bash", "scripts/stop-mlx.sh"],
  "health_timeout_s": 900,
  "concurrency": 4,
  "prefill_lengths": [4096, 32768],
  "extra_body": {"reasoning_effort": "none"},
  "temperature": 0.6,
  "memory": {"cap_gib": 36, "probe": ["bash", "scripts/mem-macos.sh"], "interval_s": 3},
  "require_ac": true
}
