{
  "name": "best",
  "base_url": "http://127.0.0.1:8080",
  "model": "existentialbirds/Inkling-2-Mini-mlx-vlm-4bit",
  "fork_repo": "https://github.com/existential-birds/mlx-vlm",
  "fork_branch": "perf/inkling2-serving",
  "fork_commit": "f871d0b7",
  "base_checkpoint": "thinkingmachines/Inkling-2-Mini@c9d028302cd0f035fdf8e7e91f089a4ce94d2195",
  "hub_model": "existentialbirds/Inkling-2-Mini-mlx-vlm-4bit@3d000db129f97afb3a169749a40a8ee3354c7eb2",
  "hub_draft_model": "existentialbirds/Inkling-2-Mini-DSpark-mlx-vlm-4bit@58203c8aa1c2cd1d294c8ab427cd7493ded7cb96",
  "launch": [
    "bash",
    "scripts/launch-mlx.sh",
    "best",
    "--model",
    "existentialbirds/Inkling-2-Mini-mlx-vlm-4bit",
    "--prefill-step-size",
    "512",
    "--cache-limit",
    "4294967296",
    "--max-num-seqs",
